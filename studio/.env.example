# Supabase (shared Reytek1201 project). Publishable key only, never service-role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SCHEMA=launchgrid_site
# Salt for the anonymous visitor hash used by the rate limit.
SPAM_SALT=
# Public address of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://launchgrid.studio
# Set to 1 once launchgrid.studio is the live address; until then search engines are asked not to index.
SITE_LIVE=
# Email (Resend). Without RESEND_API_KEY and EMAIL_ALERTS_TO nothing is sent and nothing breaks.
RESEND_API_KEY=
EMAIL_ALERTS_TO=reytek@launchgrid.studio
# The sender copy to the visitor goes out only once this is a verified sending domain in Resend.
EMAIL_FROM=
