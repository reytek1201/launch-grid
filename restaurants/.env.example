# Where the site reads its menu, wines, hours and closures, and where it sends requests.
# Leave these out to run entirely on the built-in demo data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...   # the publishable key; never the service-role key
SUPABASE_SCHEMA=trattoria_demo
SUPABASE_BUCKET=trattoria-demo   # the photo bucket; new-client sets this per client

# Email alerts for new requests (reservation, event, message). Without a key and a recipient nothing is sent.
RESEND_API_KEY=re_...
EMAIL_FROM="Trattoria Cinque Lune <requests@your-verified-domain.com>"
EMAIL_ALERTS_TO=owner@example.com   # comma-separated for several people
# Optional: any random text; it salts the anonymous visitor fingerprint used for the per-visitor limit.
SPAM_SALT=
